{
  "name": "marengo-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:full": "concurrently \"npm:dev:api\" \"npm:dev\"",
    "build": "npm run typecheck && vite build",
    "start": "node --import tsx server/index.ts",
    "lint": "eslint src server prisma/seed.ts scripts vite.config.ts",
    "preview": "vite preview",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "node --import tsx prisma/seed.ts",
    "deploy": "docker compose up -d --build",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test": "node --import tsx --test server/*.test.ts",
    "typecheck": "tsc -p tsconfig.app.json --incremental false && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "@prisma/client": "6.19.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/busboy": "^1.5.4",
    "@types/qrcode": "^1.5.6",
    "@types/yauzl": "^2.10.3",
    "@zip.js/zip.js": "^2.8.57",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dcmjs-codecs": "^0.0.8",
    "dicom-parser": "^1.8.21",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.17.0",
    "morgan": "^1.10.1",
    "pdfjs-dist": "^5.4.624",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "redis": "^5.8.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "yauzl": "^3.3.2",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.12.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "ajv": "^8.17.1",
    "concurrently": "^10.0.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.6.0",
    "prisma": "6.19.3",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "7.2.7"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
