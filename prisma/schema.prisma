generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CLIENT_USER
  RADIOLOGIST
  PROVIDER_ADMIN
  PROVIDER_MANAGER
}

enum ClientKind {
  GROUP
  CENTER
}

enum ClientStatus {
  ACTIVE
  BLOCKED
}

enum ServiceCategory {
  PACS
}

enum ServiceStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum JobStatus {
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
}

enum ReturnFormat {
  DICOM_ENCAPSULATED_PDF
  DICOM_SECONDARY_CAPTURE
  HL7
  HTML
  PDF
  DOCX
}

enum ReportReviewStatus {
  PENDING
  IN_REVIEW
  SAVED
  APPROVED
  PUSHED
  FAILED
}

model User {
  id                     String                    @id @default(cuid())
  userId                 String?                   @unique @map("user_id")
  email                  String                    @unique
  name                   String
  passwordHash           String
  lastGeneratedPassword  String?
  role                   UserRole
  portalRole             String?
  clientId               String?
  providerCode           String?
  client                 Client?                   @relation(fields: [clientId], references: [id])
  active                 Boolean                   @default(true)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  radiologistProfile     RadiologistProfile?
  reportAuditLogs        ReportAuditLog[]
  managedRadiologists    RadiologistProfile[]      @relation("RadiologistManager")
  createdAvailabilities  RadiologistAvailability[] @relation("AvailabilityCreator")
  managerCallActions     ReportCallBooking[]       @relation("CallManagerActions")
  radiologistCallActions ReportCallBooking[]       @relation("CallRadiologistActions")
  reviewedFeedback       RadiologistFeedback[]     @relation("FeedbackReviewer")
  submittedFeedback      RadiologistFeedback[]     @relation("FeedbackSubmitter")
  notificationDeliveries NotificationDelivery[]
  whatsappWhitelist      NotificationRecipient[]

  @@index([clientId, portalRole])
  @@map("users")
}

model Client {
  id                     String                    @id @default(cuid())
  code                   String                    @unique
  name                   String
  hospitalSlug           String?                   @unique
  kind                   ClientKind                @default(CENTER)
  parentClientId         String?
  facilityType           String
  primaryContact         String
  email                  String
  billingDiscountPercent Float                     @default(0)
  studySyncEnabled       Boolean                   @default(false)
  demoModeEnabled        Boolean                   @default(false)
  demoStudyLimit         Int?
  status                 ClientStatus              @default(ACTIVE)
  users                  User[]
  parentClient           Client?                   @relation("ClientHierarchy", fields: [parentClientId], references: [id], onDelete: SetNull)
  childClients           Client[]                  @relation("ClientHierarchy")
  services               ClientService[]
  pacsConfigs            PacsConfig[]
  apiKeys                ApiKey[]
  studies                Study[]
  jobs                   Job[]
  usageLogs              UsageLog[]
  auditLogs              AuditLog[]
  reportSettings         ReportFormatSetting[]
  hl7Config              Hl7Config?
  radiologists           RadiologistProfile[]
  reportReviews          ReportReview[]
  callBookings           ReportCallBooking[]
  processingJobs         ProcessingJob[]
  billingTransactions    StudyBillingTransaction[]
  invoices               Invoice[]
  payments               Payment[]
  billingDisputes        BillingDispute[]
  supportTickets         SupportTicket[]
  notificationRecipients NotificationRecipient[]
  availableBridgeStudies AvailableBridgeStudy[]
  bridgeDispatchRequests BridgeDispatchRequest[]
  bridgeControlCommands  BridgeControlCommand[]
  bridgeStudyAttachments BridgeStudyAttachment[]
  patients               Patient[]
  patientFollowUps       PatientFollowUp[]
  radiologistFeedback    RadiologistFeedback[]
  archivedPatientStudies PatientStudyArchive[]
  notificationEvents     NotificationEvent[]
  notificationDeliveries NotificationDelivery[]
  demoRequests           DemoRequest[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([kind, parentClientId])
  @@map("clients")
}

model Service {
  id          String          @id @default(cuid())
  name        String          @unique
  code        String          @unique
  category    ServiceCategory
  description String
  enabled     Boolean         @default(true)
  clients     ClientService[]

  @@map("services")
}

model ClientService {
  id           String          @id @default(cuid())
  clientId     String
  serviceId    String
  status       ServiceStatus   @default(ACTIVE)
  workflowType String          @default("AI_ONLY")
  credits      Int             @default(0)
  usedCredits  Int             @default(0)
  validFrom    DateTime        @default(now())
  validUntil   DateTime
  client       Client          @relation(fields: [clientId], references: [id])
  service      Service         @relation(fields: [serviceId], references: [id])
  creditsLog   ServiceCredit[]
  pacsConfig   PacsConfig?

  @@unique([clientId, serviceId])
  @@map("client_services")
}

model ServiceCredit {
  id              String        @id @default(cuid())
  clientServiceId String
  amount          Int
  reason          String
  createdBy       String
  createdAt       DateTime      @default(now())
  clientService   ClientService @relation(fields: [clientServiceId], references: [id])

  @@map("service_credits")
}

model PacsConfig {
  id                        String        @id @default(cuid())
  clientId                  String
  clientServiceId           String        @unique
  ec2PublicIp               String
  receivingPort             Int           @unique
  aeTitle                   String        @unique
  urgentReceivingPort       Int?          @unique
  urgentAeTitle             String?       @unique
  extraEndpoints            Json          @default("[]")
  clientPacsIp              String
  clientPacsPort            Int
  clientPacsAeTitle         String
  returnFormat              ReturnFormat  @default(DICOM_ENCAPSULATED_PDF)
  workflowType              String        @default("AI_ONLY")
  teleradiologyProviderCode String?
  outsourceTeleradiology    Boolean       @default(false)
  client                    Client        @relation(fields: [clientId], references: [id])
  clientService             ClientService @relation(fields: [clientServiceId], references: [id])

  @@map("pacs_config")
}

model ApiKey {
  id        String    @id @default(cuid())
  clientId  String
  name      String
  keyHash   String
  scopes    String[]
  active    Boolean   @default(true)
  expiresAt DateTime?
  client    Client    @relation(fields: [clientId], references: [id])

  @@map("api_keys")
}

model ReportTemplate {
  id        String   @id @default(cuid())
  name      String
  modality  String
  body      Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("report_templates")
}

model ReportFormatSetting {
  id                          String       @id @default(cuid())
  clientId                    String
  serviceName                 String
  dicomReturnFormat           ReturnFormat @default(DICOM_ENCAPSULATED_PDF)
  outputFormat                ReturnFormat @default(DICOM_ENCAPSULATED_PDF)
  reportMode                  String       @default("Comprehensive")
  radiologistReviewEnabled    Boolean      @default(false)
  includeRadiologistSignature Boolean      @default(true)
  signatureDetailFields       String[]     @default(["fullName", "qualification", "medicalRegistrationNumber", "organisationName"])
  enabledSections             String[]
  structuredHeaderJson        Json
  client                      Client       @relation(fields: [clientId], references: [id])

  @@unique([clientId, serviceName])
  @@map("report_format_settings")
}

model Study {
  id            String                @id @default(cuid())
  clientId      String
  studyUid      String                @unique
  accession     String?
  modality      String
  status        JobStatus
  aiResponse    Json?
  reportJson    Json?
  createdAt     DateTime              @default(now())
  client        Client                @relation(fields: [clientId], references: [id])
  jobs          Job[]
  reportReviews ReportReview[]
  patientId     String?
  patient       Patient?              @relation(fields: [patientId], references: [id], onDelete: SetNull)
  feedback      RadiologistFeedback[]

  @@index([clientId, patientId])
  @@map("studies")
}

model RadiologistProfile {
  id                        String                    @id @default(cuid())
  clientId                  String?
  providerCode              String?
  managerUserId             String?
  userId                    String                    @unique
  fullName                  String
  email                     String
  phone                     String?
  qualification             String
  medicalRegistrationNumber String
  organisationName          String
  signatureImageUrl         String?
  documentUrl               String?
  documentName              String?
  active                    Boolean                   @default(true)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  client                    Client?                   @relation(fields: [clientId], references: [id])
  user                      User                      @relation(fields: [userId], references: [id])
  manager                   User?                     @relation("RadiologistManager", fields: [managerUserId], references: [id])
  reportReviews             ReportReview[]
  callBookings              ReportCallBooking[]
  availabilitySlots         RadiologistAvailability[]

  @@index([providerCode])
  @@index([clientId])
  @@map("radiologist_profiles")
}

model NotificationOutbox {
  id             String    @id @default(cuid())
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        Json
  idempotencyKey String    @unique
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

model NotificationEvent {
  id             String                 @id @default(cuid())
  eventType      String
  category       String
  aggregateType  String
  aggregateId    String
  clientId       String?
  patientRef     String?
  stage          String?
  status         String
  title          String
  message        String
  metadata       Json                   @default("{}")
  idempotencyKey String                 @unique
  occurredAt     DateTime               @default(now())
  createdAt      DateTime               @default(now())
  client         Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  deliveries     NotificationDelivery[]

  @@index([clientId, eventType, occurredAt])
  @@index([category, occurredAt])
  @@index([aggregateType, aggregateId])
  @@index([status, occurredAt])
  @@map("notification_events")
}

model NotificationDelivery {
  id                    String            @id @default(cuid())
  eventId               String
  clientId              String?
  recipientUserId       String?
  recipientOrganization String
  recipientKey          String
  channel               String
  status                String            @default("QUEUED")
  attempts              Int               @default(0)
  error                 String?
  sentAt                DateTime?
  deliveredAt           DateTime?
  readAt                DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  event                 NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  client                Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  recipientUser         User?             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([eventId, recipientKey, channel])
  @@index([recipientUserId, readAt, createdAt])
  @@index([recipientOrganization, status, createdAt])
  @@index([clientId, createdAt])
  @@map("notification_deliveries")
}

model ReportReview {
  id               String                @id @default(cuid())
  clientId         String
  studyId          String?
  radiologistId    String?
  serviceName      String
  patientName      String?
  patientId        String?
  studyUid         String?
  accession        String?
  modality         String?
  status           ReportReviewStatus    @default(PENDING)
  outputFormat     ReturnFormat          @default(DICOM_ENCAPSULATED_PDF)
  aiReportJson     Json
  editedReportJson Json
  locked           Boolean               @default(false)
  generatedAt      DateTime              @default(now())
  pushedAt         DateTime?
  reviewedAt       DateTime?
  approvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  client           Client                @relation(fields: [clientId], references: [id])
  study            Study?                @relation(fields: [studyId], references: [id])
  radiologist      RadiologistProfile?   @relation(fields: [radiologistId], references: [id])
  auditLogs        ReportAuditLog[]
  callBookings     ReportCallBooking[]
  patientProfileId String?
  patientProfile   Patient?              @relation(fields: [patientProfileId], references: [id], onDelete: SetNull)
  feedback         RadiologistFeedback[]
  followUps        PatientFollowUp[]
  publicShares     ReportPublicShare[]

  @@index([clientId, patientProfileId])
  @@index([clientId, studyUid, status])
  @@index([studyUid, createdAt])
  @@index([radiologistId, status])
  @@index([updatedAt])
  @@map("report_reviews")
}

model ReportPublicShare {
  id        String       @id @default(cuid())
  reportId  String
  token     String       @unique
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  report    ReportReview @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId])
  @@index([expiresAt])
  @@map("report_public_shares")
}

model Patient {
  id                String                 @id @default(cuid())
  clientId          String
  patientIdentifier String
  name              String
  dateOfBirth       DateTime?
  age               String?
  gender            String?
  sex               String?
  phone             String?
  email             String?
  address           String?
  clinicalHistory   String?
  medicalHistory    String?
  followUpInfo      String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  client            Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  studies           Study[]
  reports           ReportReview[]
  processingJobs    ProcessingJob[]
  bridgeStudies     AvailableBridgeStudy[]
  followUps         PatientFollowUp[]
  feedback          RadiologistFeedback[]
  archivedStudies   PatientStudyArchive[]

  @@unique([clientId, patientIdentifier])
  @@index([clientId, name])
  @@index([clientId, dateOfBirth])
  @@map("patients")
}

model PatientFollowUp {
  id             String        @id @default(cuid())
  clientId       String
  patientId      String
  reportId       String?
  required       Boolean       @default(true)
  followUpDate   DateTime
  reason         String
  status         String        @default("PENDING")
  notes          String?
  assignedUserId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  report         ReportReview? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([clientId, status, followUpDate])
  @@index([patientId, followUpDate])
  @@map("patient_follow_ups")
}

model PatientStudyArchive {
  id                 String                    @id @default(cuid())
  clientId           String
  patientId          String
  studyInstanceUid   String?
  accessionNumber    String?
  studyDate          DateTime?
  modality           String?
  studyDescription   String
  bodyRegion         String?
  clinicalIndication String?
  institutionName    String?
  referringPhysician String?
  seriesCount        Int?
  instanceCount      Int?
  createdByUserId    String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  client             Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  patient            Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  files              PatientStudyArchiveFile[]

  @@index([clientId, patientId, studyDate])
  @@index([studyInstanceUid])
  @@map("patient_study_archives")
}

model PatientStudyArchiveFile {
  id           String              @id @default(cuid())
  archiveId    String
  role         String
  originalName String
  storedName   String
  filePath     String
  mimeType     String?
  sizeBytes    BigInt              @default(0)
  createdAt    DateTime            @default(now())
  archive      PatientStudyArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@index([archiveId, role])
  @@map("patient_study_archive_files")
}

model RadiologistFeedback {
  id                 String       @id @default(cuid())
  clientId           String
  patientId          String?
  studyId            String?
  reportId           String
  radiologistUserId  String
  feedbackType       String
  comment            String
  overallRating      Int?
  accuracyAssessment String?
  falsePositive      Boolean      @default(false)
  falseNegative      Boolean      @default(false)
  missedFinding      Boolean      @default(false)
  incorrectFinding   Boolean      @default(false)
  severity           String?
  categories         String[]     @default([])
  submissionVersion  Int          @default(1)
  status             String       @default("NEW")
  internalNotes      String?
  reviewedById       String?
  reviewedAt         DateTime?
  renewistStatus     String       @default("PENDING")
  renewistSyncedAt   DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  client             Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  patient            Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  study              Study?       @relation(fields: [studyId], references: [id], onDelete: SetNull)
  report             ReportReview @relation(fields: [reportId], references: [id], onDelete: Cascade)
  radiologist        User         @relation("FeedbackSubmitter", fields: [radiologistUserId], references: [id])
  reviewedBy         User?        @relation("FeedbackReviewer", fields: [reviewedById], references: [id])

  @@unique([reportId, radiologistUserId, submissionVersion])
  @@index([clientId, status, createdAt])
  @@index([radiologistUserId, createdAt])
  @@index([reportId])
  @@index([renewistStatus])
  @@map("radiologist_feedback")
}

model ReportCallBooking {
  id                          String              @id @default(cuid())
  reportId                    String
  clientId                    String
  radiologistId               String?
  slotStart                   DateTime
  slotEnd                     DateTime
  status                      String              @default("BOOKED")
  requestedDurationMinutes    Int                 @default(15)
  actualDurationMinutes       Int?
  communicationMode           String              @default("BUILT_IN_MEETING")
  phoneNumber                 String?
  pricePerMinuteMinor         Int                 @default(1000)
  estimatedAmountMinor        Int                 @default(15000)
  finalAmountMinor            Int?
  managerAcceptedAt           DateTime?
  managerAcceptedByUserId     String?
  radiologistAcceptedAt       DateTime?
  radiologistAcceptedByUserId String?
  completedAt                 DateTime?
  billedTransactionId         String?
  meetingRoom                 String              @unique
  meetingUrl                  String
  createdByUserId             String?
  reason                      String?
  requestMessage              String?
  urgency                     String              @default("ROUTINE")
  confirmedAt                 DateTime?
  cancelledAt                 DateTime?
  rescheduledAt               DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  report                      ReportReview        @relation(fields: [reportId], references: [id])
  client                      Client              @relation(fields: [clientId], references: [id])
  radiologist                 RadiologistProfile? @relation(fields: [radiologistId], references: [id])
  managerAcceptedBy           User?               @relation("CallManagerActions", fields: [managerAcceptedByUserId], references: [id])
  radiologistAcceptedBy       User?               @relation("CallRadiologistActions", fields: [radiologistAcceptedByUserId], references: [id])

  @@map("report_call_bookings")
}

model RadiologistAvailability {
  id              String             @id @default(cuid())
  providerCode    String
  radiologistId   String
  slotStart       DateTime
  slotEnd         DateTime
  durationMinutes Int                @default(15)
  status          String             @default("AVAILABLE")
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  radiologist     RadiologistProfile @relation(fields: [radiologistId], references: [id])
  createdBy       User?              @relation("AvailabilityCreator", fields: [createdByUserId], references: [id])

  @@index([providerCode, slotStart])
  @@index([radiologistId, slotStart])
  @@map("radiologist_availability")
}

model ReportAuditLog {
  id          String       @id @default(cuid())
  reportId    String
  actorUserId String?
  action      String
  metadata    Json
  createdAt   DateTime     @default(now())
  report      ReportReview @relation(fields: [reportId], references: [id])
  actor       User?        @relation(fields: [actorUserId], references: [id])

  @@index([reportId])
  @@map("report_audit_logs")
}

model Job {
  id          String    @id @default(cuid())
  clientId    String
  studyId     String?
  serviceName String
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  error       String?
  latencyMs   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  client      Client    @relation(fields: [clientId], references: [id])
  study       Study?    @relation(fields: [studyId], references: [id])

  @@map("jobs")
}

model UsageLog {
  id          String   @id @default(cuid())
  clientId    String
  serviceName String
  studyUid    String?
  creditsUsed Int
  success     Boolean
  message     String
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id])

  @@map("usage_logs")
}

model PricingRule {
  id                   String    @id @default(cuid())
  serviceName          String
  workflowType         String    @default("ANY")
  priority             String    @default("REGULAR")
  category             String    @default("REGULAR")
  currency             String    @default("INR")
  unitPriceMinor       Int       @default(0)
  providerPayableMinor Int       @default(0)
  active               Boolean   @default(true)
  validFrom            DateTime  @default(now())
  validUntil           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([serviceName, workflowType, priority, category, validFrom])
  @@map("pricing_rules")
}

model StudyBillingTransaction {
  id              String   @id @default(cuid())
  clientId        String
  processingJobId String?
  studyId         String?
  serviceName     String
  workflowType    String   @default("AI_ONLY")
  priority        String   @default("REGULAR")
  category        String   @default("REGULAR")
  units           Int      @default(1)
  unitPriceMinor  Int      @default(0)
  amountMinor     Int      @default(0)
  currency        String   @default("INR")
  status          String   @default("UNINVOICED")
  invoiceId       String?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  client          Client   @relation(fields: [clientId], references: [id])
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])

  @@unique([processingJobId, serviceName])
  @@index([clientId, createdAt])
  @@map("study_billing_transactions")
}

model Invoice {
  id                    String                    @id @default(cuid())
  clientId              String
  invoiceNumber         String                    @unique
  periodStart           DateTime
  periodEnd             DateTime
  status                String                    @default("DRAFT")
  currency              String                    @default("INR")
  subtotalMinor         Int                       @default(0)
  taxMinor              Int                       @default(0)
  totalMinor            Int                       @default(0)
  razorpayPaymentLinkId String?
  paymentUrl            String?
  issuedAt              DateTime?
  paidAt                DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  client                Client                    @relation(fields: [clientId], references: [id])
  lineItems             InvoiceLineItem[]
  transactions          StudyBillingTransaction[]
  paymentLinks          PaymentLink[]
  payments              Payment[]

  @@index([clientId, createdAt])
  @@map("invoices")
}

model InvoiceLineItem {
  id             String  @id @default(cuid())
  invoiceId      String
  description    String
  serviceName    String
  units          Int
  unitPriceMinor Int
  amountMinor    Int
  currency       String  @default("INR")
  metadata       Json    @default("{}")
  invoice        Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_line_items")
}

model PaymentLink {
  id             String    @id @default(cuid())
  invoiceId      String
  provider       String    @default("RAZORPAY")
  providerLinkId String?
  shortUrl       String?
  amountMinor    Int
  currency       String    @default("INR")
  status         String    @default("CREATED")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoice        Invoice   @relation(fields: [invoiceId], references: [id])

  @@map("payment_links")
}

model Payment {
  id                String   @id @default(cuid())
  clientId          String
  invoiceId         String
  provider          String   @default("OFFLINE")
  providerPaymentId String?
  amountMinor       Int
  currency          String   @default("INR")
  status            String   @default("CAPTURED")
  method            String?
  paidAt            DateTime @default(now())
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  client            Client   @relation(fields: [clientId], references: [id])
  invoice           Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([provider, providerPaymentId])
  @@index([invoiceId, status])
  @@index([clientId, createdAt])
  @@map("payments")
}

model ProviderPayableTransaction {
  id               String              @id @default(cuid())
  providerCode     String
  dectrocelJobId   String
  processingJobId  String?
  serviceName      String
  workflowType     String
  priority         String              @default("REGULAR")
  category         String              @default("REGULAR")
  units            Int                 @default(1)
  unitPayableMinor Int                 @default(0)
  amountMinor      Int                 @default(0)
  currency         String              @default("INR")
  status           String              @default("UNSETTLED")
  settlementId     String?
  metadata         Json                @default("{}")
  createdAt        DateTime            @default(now())
