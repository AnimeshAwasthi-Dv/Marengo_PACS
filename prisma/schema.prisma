  dispatchRequests   BridgeDispatchRequest[]
  attachments        BridgeStudyAttachment[]
  processingJob      ProcessingJob?          @relation(fields: [processingJobId], references: [id], onDelete: SetNull)
  patientProfileId   String?
  patientProfile     Patient?                @relation(fields: [patientProfileId], references: [id], onDelete: SetNull)

  @@unique([clientId, agentId, studyInstanceUid])
