  @@index([clientId, updatedAt, id], map: "abs_client_updated_idx")
  @@index([clientId, agentId])
  @@index([clientId, patientProfileId])
  @@index([clientId, lastSyncedAt(sort: Desc), id(sort: Desc)])
  @@index([studyInstanceUid])
  @@index([updatedAt])
