# Template only. Preserve the populated private .env when deploying.
# URL-encode credentials in DATABASE_URL and use TLS for RDS.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=marengo
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=
PORTAL_DOMAIN=portal.example.com
PORTAL_BASE_URL=https://portal.example.com
CORS_ORIGIN=https://portal.example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USER_ID=admin

DEPLOYMENT_PROFILE=marengo
FEATURE_WHATSAPP_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
# See docs/WHATSAPP_REFERRING_PHYSICIAN.md for the approved report template.
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_REPORT_READY_TEMPLATE_NAME=
WHATSAPP_REPORT_READY_TEMPLATE_LANGUAGE=en
PORTAL_DASHBOARD_POLL_MS=30000
AVAILABLE_STUDIES_POLL_MS=30000
REDIS_CACHE_ENABLED=false
REDIS_URL=
REDIS_CLUSTER_MODE=true
REDIS_DASHBOARD_TTL_SECONDS=30
REDIS_TIMEOUT_MS=500
FEATURE_RENEWIST_PDF_CONVERSION_ENABLED=true
LOAD_STORAGE_ENV=false
SKIP_DICOM_FIREWALL_RULES=true
EC2_PUBLIC_IP=
PACS_PORT_START=5000
PACS_PORT_END=5099

# Set later once the viewer's URL contract is known; never put credentials here.
# Example: https://viewer.example.com/viewer?StudyInstanceUIDs={studyInstanceUid}
# The viewer must independently authenticate and have access to this study.
EXTERNAL_VIEWER_URL_TEMPLATE=

# External viewer service credentials (server-side only).
# Saved for service integration; the current link adapter uses the template above.
DICOM_VIEWER_API_URL=
DICOM_VIEWER_SERVICE_API_KEY=

# Configure the integration credentials/URLs provided by the service operator.
TELERADIOLOGY_DEFAULT_PROVIDER=RENEWIST
TELERADIOLOGY_CALLBACK_BASE_URL=https://portal.example.com
RENEWIST_OUTBOUND_API_BASE_URL=
RENEWIST_OUTBOUND_API_KEY=
RENEWIST_OUTBOUND_HMAC_SECRET=
RENEWIST_API_KEY=
RENEWIST_HMAC_SECRET=
BRIDGE_AGENT_API_TOKEN=
CT_STUDY_ENDPOINT_CONCURRENCY=1
MRI_STUDY_ENDPOINT_CONCURRENCY=1
MAMMOGRAPHY_STUDY_ENDPOINT_CONCURRENCY=1

# Optional storage; leave unset for local persistent uploads.
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ORIGINAL_STUDIES_BUCKET=
S3_STUDY_BUCKETS=
S3_VIEWER_STUDY_BUCKETS=
S3_STUDY_PREFIX=
S3_VIEWER_STUDY_PREFIX=
S3_REPORT_BUCKET=
